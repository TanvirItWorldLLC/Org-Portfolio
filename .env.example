# ====================================================================
# Org Portfolio - Environment Configuration
# ====================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git (it's in .gitignore).
# ====================================================================

# ---- Runtime ----
NODE_ENV=production

# ---- Database (MySQL 8 / MariaDB 10.6+) ----
# Local Docker:  DATABASE_URL="mysql://portfolio:portfolio@localhost:3306/org_portfolio"
# Hostinger VPS: DATABASE_URL="mysql://org_user:STRONG_PASSWORD@127.0.0.1:3306/org_portfolio"
DATABASE_URL="mysql://portfolio:portfolio@localhost:3306/org_portfolio"

# ---- Authentication ----
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-48-char-random-secret-min-aaaa
JWT_EXPIRES_IN=7d

# ---- Public URL ----
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SITE_NAME="Org Portfolio"

# ---- Admin (seeded on first run) ----
ADMIN_EMAIL=admin@orgportfolio.com
ADMIN_PASSWORD=ChangeMeAfterFirstLogin!2024
ADMIN_NAME="Admin User"

# ---- Optional ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM="Org Portfolio <noreply@yourdomain.com>"