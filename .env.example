# Production Environment Variables
# Copy this to .env and fill in your values

# Server
NODE_ENV=production
PORT=4000

# Client URL (for CORS)
CLIENT_URL=https://org-portfolio-frontend.onrender.com

# JWT Secret (auto-generated on Render if using generateValue)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database (using JSON file for simplicity)
DATABASE_PATH=./data/portfolio.json

# Optional: Email configuration (for notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM=Org Portfolio <noreply@orgportfolio.com>

# Optional: Payment providers
# STRIPE_SECRET_KEY=sk_live_...
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...

# Optional: Analytics
# GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX