// Org Portfolio - Prisma Schema
// Database: Prisma Postgres (pooled, TLS-required)

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-1.1.x"]
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

// ---- Users ----
model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      UserRole @default(USER)
  status    UserStatus @default(ACTIVE)
  avatar    String?
  lastLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders    Order[]

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

enum UserRole {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// ---- Categories ----
model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  color       String   @default("#0ea5e9")
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  projects    Project[]

  @@index([slug])
  @@map("categories")
}

// ---- Projects ----
model Project {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String
  longDescription String?
  thumbnail      String?
  gallery        Json?
  categoryId     String?
  technologies   Json?
  tags           Json?
  color          String   @default("#0ea5e9")
  status         ProjectStatus @default(DRAFT)
  featured       Boolean  @default(false)
  views          Int      @default(0)
  clientName     String?
  projectUrl     String?
  githubUrl      String?
  duration       String?
  teamSize       Int?
  challenges     Json?
  solutions      Json?
  results        Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@index([categoryId])
  @@index([featured])
  @@map("projects")
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ---- Orders ----
model Order {
  id             String   @id @default(cuid())
  orderNumber    String   @unique
  projectType    String
  plan           String
  totalPrice     Int
  status         OrderStatus @default(PENDING)
  projectDetails Json?
  contactInfo    Json
  userId         String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([orderNumber])
  @@map("orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  REVIEW
  COMPLETED
  CANCELLED
}

// ---- Settings (singleton row) ----
model Setting {
  id                  String   @id @default("default")
  siteName            String   @default("Org Portfolio")
  siteDescription     String?
  siteUrl             String?
  contactEmail        String?
  primaryColor        String   @default("#0ea5e9")
  secondaryColor      String   @default("#8b5cf6")
  darkMode            String   @default("system")
  emailNewOrder       String   @default("true")
  emailOrderUpdates   String   @default("true")
  emailNewUser        String   @default("true")
  twoFactorAuth       String   @default("false")
  sessionTimeout      Int      @default(30)
  maxLoginAttempts    Int      @default(5)
  passwordMinLength   Int      @default(8)
  apiRateLimit        Int      @default(1000)
  apiEnabled          String   @default("true")
  maintenanceMode     String   @default("false")
  logRetention        Int      @default(90)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("settings")
}